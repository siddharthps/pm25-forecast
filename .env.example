# Copy to .env (gitignored) and fill in locally. Never commit .env; never paste values in chat.
# Settings are read and validated in one place: src/airwatch/config.py (T3).

# EPA AirNow API (live observations). Key from your AirNow account page.
AIRNOW_API_KEY=

# EPA AQS Data Mart API (validated history). Registered email + key.
AQS_EMAIL=
AQS_API_KEY=

# The chosen metro area's IANA time zone, for local calendar days. Chicago until T4 settles
# the city. (The 06:00 issue time is always America/Chicago: D-019, not a setting.)
CITY_TZ=America/Chicago

# AWS: no keys here. Locally use your SSO profile (`aws sso login --profile pm25`).
AWS_PROFILE=pm25
AWS_REGION=us-east-1
